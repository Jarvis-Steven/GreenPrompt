# Copy this file to backend/.env and fill in real values there.
# backend/.env is git-ignored. NEVER put real credentials in THIS file.

# Browser origins allowed to call the API (comma separated).
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
DATABASE_PATH=greenprompt.db

# Labelled stand-ins for teammates' unfinished functions. 1 = on (local dev only).
GREENPROMPT_DEV_STUBS=0

# Total deadline for one answer call, in seconds.
PROVIDER_TIMEOUT_SECONDS=30

# --- Difficulty classifier (rules first, one model call only when rules cannot decide) ---
# Which tier runs the classifier, and its own deadline. No automatic retry.
CLASSIFIER_TIER=small
CLASSIFIER_TIMEOUT_SECONDS=5

# --- Providers, one group per tier ---
# Any OpenAI-compatible chat endpoint. BASE_URL has no trailing /chat/completions.
# Example BASE_URL for Groq: https://api.groq.com/openai/v1
SMALL_BASE_URL=
SMALL_API_KEY=
SMALL_MODEL=

MEDIUM_BASE_URL=
MEDIUM_API_KEY=
MEDIUM_MODEL=

BIG_BASE_URL=
BIG_API_KEY=
BIG_MODEL=
